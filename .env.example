# Example environment variables for local development.
# Copy to .env and fill in real values. NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ── MySQL ─────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rajneeti_db
DB_USERNAME=rajneeti_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# ── JPA ───────────────────────────────────────────────────────────────────────
# Options: validate | update | create | create-drop
# Use 'validate' in production; 'update' in dev
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ── JWT ───────────────────────────────────────────────────────────────────────
# MUST be a Base64-encoded string of at least 32 random bytes (256 bits).
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_BASE64_ENCODED_256BIT_SECRET
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_SQL=WARN
