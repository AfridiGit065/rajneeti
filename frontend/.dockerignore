# Dependencies — reinstalled by `npm ci` in the deps stage
node_modules/

# Build output — regenerated by `npm run build`
.next/
out/
tsconfig.tsbuildinfo

# Local environment / secrets — NEXT_PUBLIC_* comes from build args instead
.env
.env.*
!.env.example
!.env.local.example

# VCS + editor metadata
.git/
.gitignore
.vscode/
.idea/
*.iml

# Logs and caches
*.log
logs/
.npm/
.eslintcache

# Docs / agent notes — not needed to build or serve
README.md
CLAUDE.md
AGENTS.md
docs/

# Test sources — not needed in the production image
test/
